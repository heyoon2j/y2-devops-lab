# Managed [main] values. Other existing settings are preserved by configure.
[main]
server = {{puppet_fqdn}}
ca_server = {{ca_fqdn}}
certname = {{certname}}
environment = {{puppet_environment}}
localcacert = {{ca_cert}}
hostcert = {{host_cert}}
hostprivkey = {{host_key}}
runinterval = 30m
splay = true
splaylimit = 30m
usecacheonfailure = false
use_cached_catalog = false
report = true
show_diff = false
waitforcert = 0
http_connect_timeout = 30
http_read_timeout = 120
