# Native foreman-installer answers overlay. Edit settings here.
puppet:
  client_package: openvox-agent
  server_package: openvox-server
  manage_packages: false
  server: true
  server_ca: false
  runmode: none
  server_certname: '{{puppet_certname}}'
  client_certname: '{{puppet_certname}}'
  ssldir: /etc/puppetlabs/puppet/ssl
  server_ssl_dir: /etc/puppetlabs/puppet/ssl
  server_ssl_key_manage: false
  server_foreman: true
  server_foreman_facts: true
  server_reports:
  - foreman
  server_foreman_url: https://{{foreman_fqdn}}
  server_foreman_ssl_ca: '{{ca_cert}}'
  server_foreman_ssl_cert: '{{host_cert}}'
  server_foreman_ssl_key: '{{host_key}}'
foreman_proxy:
  foreman_base_url: https://{{foreman_fqdn}}
  ssl: true
  http: false
  ssl_ca: '{{ca_cert}}'
  ssl_cert: '{{host_cert}}'
  ssl_key: '{{host_key}}'
  puppet: true
  puppetca: false
  puppet_url: https://{{puppet_fqdn}}:8140
  puppet_ssl_ca: '{{ca_cert}}'
  puppet_ssl_cert: '{{host_cert}}'
  puppet_ssl_key: '{{host_key}}'
  register_in_foreman: false
  dns: false
  dhcp: false
  tftp: false
