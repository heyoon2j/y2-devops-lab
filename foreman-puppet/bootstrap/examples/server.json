{
  "os": {
    "id": "ubuntu",
    "version": "24.04",
    "architecture": "x86_64"
  },
  "host_fqdn": null,
  "foreman_fqdn": null,
  "puppet_fqdn": null,
  "puppet_certname": null,
  "repository_keys": {
    "foreman": null,
    "openvox": "0E26429987002418F9513F2A5FB999C2D62FF3D9"
  },
  "package_versions": {
    "foreman": null,
    "foreman-installer": null,
    "foreman-proxy": null,
    "ruby-foreman-puppet": null,
    "postgresql-16": null,
    "openvox-agent": null,
    "openvox-server": null
  },
  "tls": {
    "ca_cert": null,
    "host_cert": null,
    "host_key": null
  },
  "installer": {
    "foreman_args": [
      "--enable-foreman",
      "--enable-foreman-plugin-puppet",
      "--foreman-db-manage=true",
      "--foreman-db-host=localhost",
      "--foreman-servername={foreman_fqdn}",
      "--foreman-foreman-url=https://{foreman_fqdn}",
      "--foreman-server-ssl-ca={ca_cert}",
      "--foreman-server-ssl-cert={host_cert}",
      "--foreman-server-ssl-key={host_key}"
    ],
    "openvox_args": [
      "--enable-puppet",
      "--enable-foreman-proxy",
      "--puppet-client-package=openvox-agent",
      "--puppet-server-package=openvox-server",
      "--puppet-manage-packages=false",
      "--puppet-server=true",
      "--puppet-server-ca=false",
      "--puppet-runmode=none",
      "--puppet-server-certname={puppet_certname}",
      "--puppet-client-certname={puppet_certname}",
      "--puppet-ssldir=/etc/puppetlabs/puppet/ssl",
      "--puppet-server-ssl-dir=/etc/puppetlabs/puppet/ssl",
      "--puppet-server-ssl-key-manage=false",
      "--puppet-server-foreman=true",
      "--puppet-server-foreman-facts=true",
      "--puppet-server-reports=foreman",
      "--puppet-server-foreman-url=https://{foreman_fqdn}",
      "--puppet-server-foreman-ssl-ca={ca_cert}",
      "--puppet-server-foreman-ssl-cert={host_cert}",
      "--puppet-server-foreman-ssl-key={host_key}",
      "--foreman-proxy-foreman-base-url=https://{foreman_fqdn}",
      "--foreman-proxy-ssl=true",
      "--foreman-proxy-http=false",
      "--foreman-proxy-ssl-ca={ca_cert}",
      "--foreman-proxy-ssl-cert={host_cert}",
      "--foreman-proxy-ssl-key={host_key}",
      "--foreman-proxy-puppet=true",
      "--foreman-proxy-puppetca=false",
      "--foreman-proxy-puppet-url=https://{puppet_fqdn}:8140",
      "--foreman-proxy-puppet-ssl-ca={ca_cert}",
      "--foreman-proxy-puppet-ssl-cert={host_cert}",
      "--foreman-proxy-puppet-ssl-key={host_key}",
      "--foreman-proxy-register-in-foreman=false",
      "--foreman-proxy-dns=false",
      "--foreman-proxy-dhcp=false",
      "--foreman-proxy-tftp=false"
    ]
  }
}
